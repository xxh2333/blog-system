# 应用基础配置
APP_NAME=BlogSystem
APP_ENV=local
APP_KEY=  # 留空，队友执行 php artisan key:generate 自动生成
APP_DEBUG=true
APP_URL=http://localhost

# 本地化配置（改为中文，适配国内开发）
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN  # 假数据生成用中文

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12  # 密码加密强度，默认即可

# 日志配置（默认即可）
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 数据库配置（取消注释，保留默认值，密码留空）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blog_system  # 改为你的项目数据库名（团队统一）
DB_USERNAME=root
DB_PASSWORD=  # 留空（队友填自己的本地密码）

# Session 配置（默认即可）
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# 广播/文件/队列配置（默认即可）
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# 缓存配置（默认即可）
CACHE_STORE=database
# CACHE_PREFIX=

# Memcached/Redis 配置（默认即可，不用改）
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 邮箱服务配置（SMTP 模板 队友按需改）
# 邮箱服务配置（SMTP 模板）
MAIL_MAILER=smtp
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=你的邮箱地址
MAIL_PASSWORD=你的邮箱授权码
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@blog-system.com
MAIL_FROM_NAME="${APP_NAME}"

# AWS 配置（留空即可，不用改）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite 配置（默认即可）
VITE_APP_NAME="${APP_NAME}"

# ========== 新增：JWT 核心配置（适配你的 JWT 集成） ==========
JWT_SECRET=  # 留空，队友执行 php artisan jwt:secret 自动生成
JWT_TTL=60  # JWT 令牌过期时间（分钟）
JWT_REFRESH_TTL=20160  # JWT 刷新令牌过期时间（分钟）
JWT_ALGO=HS256  # JWT 加密算法（默认即可）